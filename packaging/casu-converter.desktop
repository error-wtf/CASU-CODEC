[Desktop Entry]
Type=Application
Name=CASU Converter
Comment=Analyze, convert, verify and benchmark media with CASU
Exec=casu-converter %F
Icon=casu-converter
Terminal=false
Categories=AudioVideo;
MimeType=video/mp4;video/x-matroska;video/webm;audio/mpeg;audio/flac;application/x-casu;
StartupNotify=true
